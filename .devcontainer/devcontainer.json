{
	"name": "ISIX-RTOS (QEMU)",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"workspaceFolder": "/workspaces/isixrtos",
	"remoteUser": "vscode",
	"containerEnv": {
		"PATH": "/opt/arm-none-eabi-gcc/bin:/opt/qemu/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
	},
	"postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"mesonbuild.mesonbuild"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	"forwardPorts": [
		1234
	],
	"portsAttributes": {
		"1234": {
			"label": "QEMU GDB"
		}
	}
}
