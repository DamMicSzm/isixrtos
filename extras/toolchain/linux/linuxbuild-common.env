# Linux native build of arm-none-eabi toolchain (same family as mac/win scripts).

TARGET=arm-none-eabi
BASENAME=arm-none-eabi-gcc

# Keep in sync with project needs: meson uses gnu++23 (see meson.build).
BINUTILS_VER=2.43
GCC_VER=14.2.0
NEWLIB_VER=4.5.0.20241231
GDB_VER=15.2

PREFIX="${PREFIX:-/opt/arm-none-eabi-gcc}"
CHOST="${CHOST:-$(gcc -dumpmachine)}"
BUILD_JOBS="${BUILD_JOBS:-$(nproc)}"

declare -A dl_urls=(
	[binutils]="https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VER}.tar.xz"
	[gcc]="https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VER}/gcc-${GCC_VER}.tar.xz"
	[newlib]="https://sourceware.org/pub/newlib/newlib-${NEWLIB_VER}.tar.gz"
	[gdb]="https://ftp.gnu.org/gnu/gdb/gdb-${GDB_VER}.tar.xz"
)

declare -A pkg_dirs=(
	[binutils]="binutils-${BINUTILS_VER}"
	[gcc]="gcc-${GCC_VER}"
	[newlib]="newlib-${NEWLIB_VER}"
	[gdb]="gdb-${GDB_VER}"
)

BASEDIR="${BASEDIR:-$(pwd)/tmp}"
DLDIR="${BASEDIR}/dl"
